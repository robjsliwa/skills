# docker-compose for {{PROJECT_NAME}}

services:

  app:
    build:
      context: ..
      dockerfile: deploy/Dockerfile
      args:
        VERSION: dev
        COMMIT: local
    image: {{PROJECT_NAME}}:dev
    ports:
      - "${HTTP_PORT:-8080}:8080"
    env_file: ../.env
