# -------------------------------------------------------------------
# {{PROJECT_NAME}} — local environment
# -------------------------------------------------------------------
# Copy this file to .env (which is gitignored) and adjust as needed.

# --- HTTP server ---
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_MAX_BODY_BYTES=1048576       # 1MB
SHUTDOWN_TIMEOUT=30s

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Logging ---
LOG_LEVEL=info                    # debug | info | warn | error
LOG_FORMAT=json                   # json | text

# --- OpenTelemetry ---
OTEL_SERVICE_NAME={{PROJECT_NAME}}
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_EXPORTER=otlp         # otlp | none
OTEL_METRICS_EXPORTER=otlp        # otlp | none
OTEL_LOGS_EXPORTER=otlp           # otlp | none
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev

# --- Authentication (JWT/OAuth validation) ---
AUTH_ENABLED=true
AUTH_ALGORITHM=RS256              # RS256 | ES256 | HS256
AUTH_ISSUER=https://my-idp.example.com/
AUTH_AUDIENCE=https://api.{{PROJECT_NAME}}.example.com
AUTH_JWKS_URL=https://my-idp.example.com/.well-known/jwks.json
AUTH_JWKS_REFRESH_INTERVAL=10m
# AUTH_HMAC_SECRET=                 # Required ONLY if AUTH_ALGORITHM=HS256
AUTH_REQUIRED_SCOPES=
AUTH_CLOCK_SKEW=30s
AUTH_SKIP_PATHS=/healthz,/readyz,/docs

