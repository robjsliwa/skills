#!/usr/bin/env bash
# Pre-commit hook for {{PROJECT_NAME}}
# Installed via: make install-hooks
# Bypass once: git commit --no-verify

set -eo pipefail

if [ -t 1 ]; then
    GREEN=$'\033[0;32m'; YELLOW=$'\033[0;33m'; RED=$'\033[0;31m'; BLUE=$'\033[0;34m'; NC=$'\033[0m'
else
    GREEN=""; YELLOW=""; RED=""; BLUE=""; NC=""
fi

step() { echo "${BLUE}→${NC} $*"; }
ok()   { echo "${GREEN}✓${NC} $*"; }
warn() { echo "${YELLOW}⚠${NC} $*"; }
fail() { echo "${RED}✗${NC} $*" >&2; }

# 1. Collect staged Go files
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' | grep -v '^docs/docs\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
    ok "No Go files staged; skipping pre-commit checks"
    exit 0
fi

echo "${BLUE}Running pre-commit checks on $(echo "$STAGED_GO_FILES" | wc -l | tr -d ' ') Go file(s)...${NC}"
echo ""

# 2. gofmt
step "gofmt"
UNFORMATTED=$(echo "$STAGED_GO_FILES" | xargs gofmt -l)
if [ -n "$UNFORMATTED" ]; then
    fail "Files need formatting:"
    echo "$UNFORMATTED" | sed 's/^/    /'
    fail "Run: make fmt"
    exit 1
fi
ok "gofmt clean"

# 3. go vet
step "go vet"
if ! go vet ./... 2>&1; then
    fail "go vet failed"
    exit 1
fi
ok "go vet clean"

# 4. Fast tests
step "go test (fast)"
if ! go test -short -count=1 ./... > /tmp/precommit-test-output 2>&1; then
    fail "Tests failed"
    cat /tmp/precommit-test-output
    rm -f /tmp/precommit-test-output
    exit 1
fi
rm -f /tmp/precommit-test-output
ok "tests pass"

# 5. golangci-lint (incremental) if installed
if command -v golangci-lint > /dev/null 2>&1; then
    step "golangci-lint (incremental)"
    if git rev-parse --verify HEAD~1 > /dev/null 2>&1; then
        if ! golangci-lint run --new-from-rev=HEAD~1 2>&1; then
            fail "golangci-lint reported issues in changed code"
            exit 1
        fi
    else
        if ! golangci-lint run 2>&1; then
            fail "golangci-lint reported issues"
            exit 1
        fi
    fi
    ok "lint clean"
else
    warn "golangci-lint not installed; skipping"
fi

# 6. OpenAPI spec drift if handlers changed
HANDLER_CHANGES=$(echo "$STAGED_GO_FILES" | grep -E 'internal/adapters/http/|cmd/server/main\.go' || true)
if [ -n "$HANDLER_CHANGES" ]; then
    if command -v swag > /dev/null 2>&1; then
        step "OpenAPI spec drift (handlers changed)"
        TMP_DOCS=$(mktemp -d)
        if swag init -g cmd/server/main.go -o "$TMP_DOCS" --parseInternal --parseDependency --quiet 2>&1; then
            if ! diff -q "$TMP_DOCS/swagger.yaml" docs/swagger.yaml > /dev/null 2>&1; then
                fail "OpenAPI spec is stale. Run: make swagger && git add docs/"
                rm -rf "$TMP_DOCS"
                exit 1
            fi
            ok "OpenAPI spec is up to date"
        else
            warn "swag init failed; CI will catch this"
        fi
        rm -rf "$TMP_DOCS"
    else
        warn "swag not installed; skipping spec drift check (CI will verify)"
    fi
fi

echo ""
ok "${GREEN}All pre-commit checks passed${NC}"
